<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.YarnSpace" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_sage</item>
        <item name="colorSecondary">@color/bg_dimmed</item>

        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_darker</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="colorSurface">@color/bg_dimmed</item>
        <item name="colorSurfaceVariant">@color/bg_darker</item>

        <item name="colorOnBackground">@color/text_graphite</item>
        <item name="colorOnSurface">@color/text_graphite</item>
        <item name="colorOnSurfaceVariant">@color/text_graphite</item>

        <item name="colorSecondaryContainer">@color/dimm_effect</item>
        <item name="colorOnSecondaryContainer">@color/text_graphite</item>

        <item name="colorControlHighlight">@color/dimm_effect</item>
    </style>

    <style name="Theme.YarnSpace" parent="Base.Theme.YarnSpace" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_system_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.YarnSpace</item>
    </style>
</resources>