<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/projectDetailsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnProjectDetailsBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnPrimary" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProjectDetailsAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/colorOnPrimary"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvProjectDetailsAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text=""
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnProjectDetailsReblog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_reblog"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="?attr/colorOnPrimary" />

        <ImageButton
            android:id="@+id/btnProjectDetailsSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save"
            android:padding="8dp"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProjectDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnBackground"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="@string/project_details_title_placeholder" />

            <TextView
                android:id="@+id/tvProjectDetailsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                android:text="@string/project_details_content_placeholder" />

            <ImageView
                android:id="@+id/ivProjectDetailsImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/tvProjectDetailsSpecTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="@string/project_details_spec_title" />

            <LinearLayout
                android:id="@+id/layoutProjectDetailsSpecTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_hook_size" />

                    <TextView
                        android:id="@+id/tvSpecHookSizeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_pattern" />

                    <TextView
                        android:id="@+id/tvSpecPatternValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_yarn_type" />

                    <TextView
                        android:id="@+id/tvSpecYarnTypeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_yarn_amount" />

                    <TextView
                        android:id="@+id/tvSpecYarnAmountValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_time_to_complete" />

                    <TextView
                        android:id="@+id/tvSpecTimeToCompleteValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.45"
                        android:textColor="?attr/colorOnBackground"
                        android:textStyle="bold"
                        android:text="@string/spec_additional_materials" />

                    <TextView
                        android:id="@+id/tvSpecAdditionalMaterialsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.55"
                        android:textColor="?attr/colorOnBackground"
                        android:text="" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
