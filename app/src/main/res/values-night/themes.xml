<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.YarnSpace" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/accent_sage_night</item>
        <item name="colorOnPrimary">@color/text_on_accent_night</item>
        <item name="colorOnPrimaryContainer">@color/text_on_accent_night</item>

        <item name="colorSecondary">@color/bg_darker_night</item>

        <item name="android:windowBackground">@color/bg_night</item>
        <item name="android:statusBarColor">@color/bg_darker_night</item>
        <item name="android:navigationBarColor">@color/bg_darker_night</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorSurface">@color/bg_dimmed_night</item>
        <item name="colorSurfaceVariant">@color/icon_inactive_night</item>
        <item name="colorOnBackground">@color/text_night</item>
        <item name="colorOnSurface">@color/icon_active_night</item>
        <item name="colorOnSurfaceVariant">@color/icon_active_night</item>

        <item name="colorSecondaryContainer">@color/dimm_effect_night</item>
        <item name="colorOnSecondaryContainer">@color/icon_active_night</item>

        <item name="colorControlHighlight">@color/dimm_effect_night</item>

    </style>

    <style name="Theme.YarnSpace" parent="Base.Theme.YarnSpace" />

    <style name="ThemeOverlay.YarnSpace.Accent" parent="" />

    <style name="ThemeOverlay.YarnSpace.Accent.Sage" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_sage_night</item>
        <item name="colorPrimaryContainer">@color/accent_sage_night</item>
    </style>

    <style name="ThemeOverlay.YarnSpace.Accent.Peach" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_peach_night</item>
        <item name="colorPrimaryContainer">@color/accent_peach_night</item>
    </style>

    <style name="ThemeOverlay.YarnSpace.Accent.Lavender" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_lavender_night</item>
        <item name="colorPrimaryContainer">@color/accent_lavender_night</item>
    </style>

    <style name="ThemeOverlay.YarnSpace.Accent.Yellow" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_yellow_night</item>
        <item name="colorPrimaryContainer">@color/accent_yellow_night</item>
    </style>

    <style name="ThemeOverlay.YarnSpace.Accent.Pink" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_pink_night</item>
        <item name="colorPrimaryContainer">@color/accent_pink_night</item>
    </style>

    <style name="ThemeOverlay.YarnSpace.Accent.Blue" parent="ThemeOverlay.YarnSpace.Accent">
        <item name="colorPrimary">@color/accent_blue_night</item>
        <item name="colorPrimaryContainer">@color/accent_blue_night</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_system_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.YarnSpace</item>
    </style>
</resources>